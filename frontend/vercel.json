{
  "version": 2,
  "functions": {
    "backend/server.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    {
      "source": "/api-proxy/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/logs(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
